{
  "name": "suha-ai-tutor",
  "version": "1.0.0",
  "description": "Offline AI-powered learning platform for Ethiopian students (Grades 7-12)",
  "author": "Suha Seid",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "./",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postinstall": "electron-builder install-app-deps",
    "generate:icon": "node scripts/generate-icon.cjs",
    "fetch:books": "node scripts/fetch-books.cjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run generate:icon && npm run build && electron-builder --win",
    "build:mac": "npm run generate:icon && npm run build && electron-builder --mac",
    "build:linux": "npm run generate:icon && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.3.9",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tanstack/react-query": "^5.59.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.451.0",
    "pdfjs-dist": "^4.7.76",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "zustand": "^4.5.5"
  }
}
